# Copy to backend/.env and fill in. Never commit backend/.env.

# Where data lives. The default SQLite file needs no setup (the free, local route).
# For PostgreSQL via Docker Compose use:
#   postgresql+psycopg://taskboard:taskboard@localhost:5432/taskboard
DATABASE_URL=sqlite:///./taskboard.db

# development | production. Production refuses to start with unsafe settings.
APP_ENV=development

# Public address of the web app (used in emails and allowed origins)
APP_URL=http://localhost:5173

# Send session cookies only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# console = print emails to the terminal (free, local); smtp = send for real
EMAIL_MODE=console
SMTP_URL=
EMAIL_FROM=Taskboard <reminders@example.com>
